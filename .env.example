# ======================================================================
# GenAI Investment Assistant — пример конфигурации.
#
# Скопируйте в .env и задайте LLM-провайдера:   cp .env.example .env
#
# .env читает ТОЛЬКО сервис agent-api (см. env_file в docker-compose.yml).
# Остальные сервисы стенда (redis/mongo/postgres/keycloak/mcp-invest/
# invest-server/librechat/oauth2-proxy) сконфигурированы прямо в
# docker-compose.yml — трогать их для запуска не нужно.
#
# В docker-режиме часть переменных ниже переопределяется внутренними
# docker-адресами прямо в docker-compose.yml (REDIS_URL, MONGO_URI,
# MCP_INVEST_URL, KEYCLOAK_URL, KEYCLOAK_ISSUER_URL) — значения в этом
# файле для них важны только при запуске agent-api ВНЕ Docker.
#
# Windows / WSL 2: см. docs/wsl2_attack_testing.md — там разобрана
# доставка запросов из контейнеров к Ollama (host.docker.internal),
# отличия Docker Desktop и нативного dockerd и генерация TLS-сертификата.
# ======================================================================

# ---------- LLM-провайдер (ОБЯЗАТЕЛЬНО задать) ----------
# По умолчанию — локальная Ollama, доступная контейнерам по host.docker.internal.
# Для Ollama значение ключа неважно, но переменная должна быть НЕПУСТОЙ.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# Модели в формате LangChain init_chat_model: "provider:model".
# Ollama-пример:     openai:qwen3:8b
# OpenRouter-пример: openai:openai/gpt-5-mini
RESEARCH_MODEL=openai:qwen3:8b
SUMMARIZATION_MODEL=openai:qwen3:8b

# Лимиты токенов на ответ — держать умеренными на провайдерах с
# ограниченным бюджетом / бесплатными кредитами.
RESEARCH_MODEL_MAX_TOKENS=2048
SUMMARIZATION_MODEL_MAX_TOKENS=1024

# Сколько шагов ReAct-цикла (LLM -> тулы -> LLM) агент делает максимум
# за один запрос.
MAX_REACT_TOOL_CALLS=2

# ---------- Хранилища ----------
# В docker-compose переопределяются на redis:6379 / mongo:27017.
# Значения ниже нужны только при запуске agent-api вне Docker.
REDIS_URL=redis://localhost:6379/0
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agent_memory
WORKING_MEMORY_TTL=86400

# ---------- MCP Инвеста ----------
# В docker-compose подставляется автоматически (http://mcp-invest:8000).
# Нужно только при запуске вне Docker.
MCP_INVEST_URL=http://localhost:8100

# ---------- Keycloak / IAM ----------
# KEYCLOAK_URL        — внутренний (docker) адрес для JWKS / обмена токенов;
#                       вне Docker укажите браузерный http-порт (8180).
# KEYCLOAK_ISSUER_URL — браузерный адрес; ОБЯЗАН совпадать с KC_HOSTNAME
#                       на контейнере keycloak (https://localhost:8443).
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ISSUER_URL=https://localhost:8443
KEYCLOAK_REALM=genai-stand
AGENT_CLIENT_ID=agent-service
AGENT_CLIENT_SECRET=agent-service-secret
UI_CLIENT_ID=streamlit-ui
UI_CLIENT_SECRET=streamlit-ui-secret
STREAMLIT_APP_CLIENT_ID=streamlit-app
