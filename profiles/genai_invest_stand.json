        "operation": "READ",
        "resource": "client_data(cus)",
        "next_component": "mcp-invest",
        "auth_scheme": "jwt",
        "boundary": "B-agent-mcp",
        "path": "app/agent/runner.py",
        "symbol": "_mcp_headers",
        "patterns": [
          "_get_agent_token\\(settings\\)"
        ],
        "policy_decision": "n/a",
        "delegation": "service_account_unrestricted",
        "subject_bound": false,
        "conditions": [
          "auth_mode=vulnerable (default)"
        ],
        "statement": "В режиме vulnerable агент ходит в MCP по токену технической УЗ без привязки к пользователю."
