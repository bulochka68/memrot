{
  "profile_id": "mempalace",
  "profile_version": "1.0.0",
  "description": "Чужая система под аудитом: MemPalace (github.com/MemPalace/mempalace), режим общего хаба — MCP поверх HTTP с bearer-токеном, qdrant-бэкенд, mesh-синхронизация с пирами. Профиль написан по коммиту d9f0590 без единой правки mcp_audit: инструменты объявлены словарём TOOLS, поэтому используется strategy=registry_dict; доменные глаголы стенда добавлены через lexicon.extend; свойства инструментов, которые движок не выводит из имени, объявлены в capabilities по собственному реестру стенда (mempalace/service.py: READ_TOOLS/WRITE_TOOLS/MAINTENANCE_TOOLS) и по коду обработчиков.",
  "servers": {"mempalace": "mcp-server"},
  "components": [
    {"id": "mcp-server", "type": "mcp_server", "name": "mempalace MCP server (hub)", "role": "external_tool_host",
     "source_paths": ["mempalace/mcp_server.py"], "deployment_ref": "mempalace"},
    {"id": "palace-store", "type": "memory_store", "name": "palace drawers (qdrant/chroma)", "role": "memory_store",
     "source_paths": ["mempalace/palace.py", "mempalace/backends"], "deployment_ref": "qdrant"},
    {"id": "knowledge-graph", "type": "memory_store", "name": "knowledge graph (sqlite)", "role": "memory_store",
     "source_paths": ["mempalace/knowledge_graph.py"]},
    {"id": "logstream", "type": "memory_store", "name": "coordination logstream (sqlite)", "role": "memory_store",
     "source_paths": ["mempalace/logstream.py"]},
    {"id": "miner", "type": "background_job", "name": "corpus miner", "role": "background_job",
     "source_paths": ["mempalace/miner.py"]},
    {"id": "logsync", "type": "background_job", "name": "anti-entropy sync with peers", "role": "background_job",
     "source_paths": ["mempalace/logsync.py", "mempalace/transport.py"]},
    {"id": "peer-node", "type": "external_provider", "name": "peer mempalace node", "role": "external_provider"}
  ],
  "principals": [
    {"id": "agent", "type": "agent", "identity_source": "body_field",
     "note": "в hub-режиме подлинность вызывающего подтверждается одним общим bearer-токеном; имя агента (from_agent/added_by) приходит параметром вызова"},
    {"id": "hub-operator", "type": "service", "identity_source": "deployment"},
    {"id": "peer-node", "type": "service", "identity_source": "shared_secret"}
  ],
  "memory_stores": [
    {"component_id": "palace-store", "store_type": "vector",
     "memory_types": [{"type": "drawer", "collection": "memories", "audience": "shared", "authority": "data",
                       "derived": true, "note": "содержимое хранится дословно и возвращается модели в результате инструмента"}],
     "observability": "wal-лог операций записи (mempalace/wal.py)"},
    {"component_id": "knowledge-graph", "store_type": "graph",
     "memory_types": [{"type": "kg_fact", "audience": "shared", "authority": "data", "derived": true}]},
    {"component_id": "logstream", "store_type": "relational",
     "memory_types": [{"type": "event", "audience": "agent", "authority": "data", "derived": false,
                       "note": "события адресуются агенту через to_agent, но это фильтр запроса, а не право доступа"},
                      {"type": "artifact", "audience": "agent", "authority": "data", "derived": false}]}
  ],
  "tool_routing": {"namespace": "qualified", "router": "TOOLS registry lookup by tool name",
                   "evidence_symbol": "TOOLS"},
  "lexicon": {
    "extend": {
      "operations": {
        "write": ["add", "ack", "submit", "checkpoint", "supersede", "invalidate", "file"],
        "read": ["traverse", "follow", "taxonomy", "status", "stats", "timeline", "peers", "duplicate", "spec", "wait"]
      },
      "server_kinds": {"memory": "server-memory|memory|knowledge|mempalace"}
    }
  },
  "capabilities": {
    "mempalace/mempalace_reconnect": {"operations": ["UPDATE"], "egress": false, "destructive": false,
                                      "target_scope": {"scope": "кэш процесса сервера, не память палаты"}},
    "mempalace/mempalace_mine": {"operations": ["CREATE", "UPDATE"], "egress": false},
    "mempalace/mempalace_sync": {"operations": ["DELETE", "UPDATE"], "egress": false, "destructive": true},
    "mempalace/mempalace_get_drawer": {"egress": false},
    "mempalace/mempalace_artifact_get": {"egress": false},
    "mempalace/mempalace_event_append": {"operations": ["CREATE"], "egress": false},
    "mempalace/mempalace_event_wait": {"operations": ["READ"], "egress": false},
    "mempalace/mempalace_task_create": {"operations": ["CREATE"], "egress": false}
  },
  "source_facts": {
    "tool_declarations": [
      {"component": "mcp-server", "path": "mempalace/mcp_server.py", "kind": "mcp", "strategy": "registry_dict",
       "symbol": "TOOLS", "description_key": "description", "schema_key": "input_schema"}
    ],
    "flows": [
      {"id": "F-drawer-write", "kind": "memory_write", "from": "mcp-server", "to": "palace-store",
       "path": "mempalace/mcp_server.py", "symbol": "tool_add_drawer",
       "patterns": ["col\\.upsert\\(", "\"added_by\": added_by", "\"source_file\": source_file or \"\"", "_wal_log\\("],
       "memory_type": "drawer", "audience": "shared", "writer_principal": "agent",
       "provenance_kept": true, "provenance_fields": ["source_file", "added_by", "filed_at", "id_recipe"],
       "statement": "Запись ящика сохраняет источник и автора в метаданных и пишет операцию в WAL.",
       "rule_refs": ["MEM-05"],
       "limitations": ["записанный автор — самозаявленный параметр вызова, а не аутентифицированный субъект"]},
      {"id": "F-drawer-scope", "kind": "scope_decision", "from": "mcp-server", "to": "palace-store",
       "path": "mempalace/mcp_server.py", "symbol": "tool_add_drawer",
       "patterns": ["added_by: str = \"mcp\"", "wing = sanitize_name\\(wing, \"wing\"\\)"],
       "decision_source": "client", "memory_type": "drawer",
       "validation": "sanitize_name/sanitize_content — синтаксическая нормализация, не решение о владельце",
       "statement": "Автор записи и её размещение (wing/room) приходят параметрами вызова; сервер их только нормализует.",
       "rule_refs": ["MEM-03"],
       "limitations": ["в локальном однопользовательском режиме это проектное решение; аудит охватывает общий hub"]},
      {"id": "F-event-write", "kind": "memory_write", "from": "mcp-server", "to": "logstream",
       "path": "mempalace/mcp_server.py", "symbol": "tool_event_append",
       "patterns": ["from_agent: str,", "ls\\.append_event\\(", "to_agent=to_agent"],
       "memory_type": "event", "audience": "agent", "writer_principal": "agent",
       "provenance_kept": true, "provenance_fields": ["from_agent", "to_agent", "correlation_id"],
       "statement": "Координационное событие пишется с самозаявленными from_agent/to_agent.",
       "rule_refs": ["MEM-05"]},
      {"id": "F-event-scope", "kind": "scope_decision", "from": "mcp-server", "to": "logstream",
       "path": "mempalace/mcp_server.py", "symbol": "tool_event_append",
       "patterns": ["from_agent: str,", "to_agent: str = None"],
       "decision_source": "client", "memory_type": "event",
       "validation": "_sanitize_routing — проверка формата идентификатора, не проверка прав",
       "statement": "Адресат и автор события выбираются вызывающим.",
       "rule_refs": ["MEM-03"]},
      {"id": "F-event-read", "kind": "memory_read", "from": "logstream", "to": "mcp-server",
       "path": "mempalace/mcp_server.py", "symbol": "tool_event_list",
       "patterns": ["to_agent: str = None", "ls\\.list_events\\(", "to_agent=to_agent"],
       "memory_type": "event", "audience": "agent", "filter_by": ["to_agent (параметр вызова)"],
       "subject_bound": false, "audience_filter_before_context": false,
       "statement": "Чтение событий фильтруется параметром to_agent, который выбирает сам вызывающий: привязки к аутентифицированному агенту нет.",
       "rule_refs": ["MEM-01", "MEM-07"],
       "limitations": ["наблюдался только код обработчика; ACL развёрнутого SQLite и сетевого периметра не проверялись"]},
      {"id": "F-search-context", "kind": "context_include", "from": "palace-store", "to": "mcp-server",
       "path": "mempalace/mcp_server.py", "symbol": "tool_search",
       "patterns": ["sanitize_query\\(query\\)"],
       "memory_type": "drawer", "presented_as": "data", "context_role": "tool_result",
       "publisher_trusted": false, "subject_bound": false,
       "statement": "Содержимое ящиков возвращается модели как данные результата инструмента; запрос санируется от подмешивания инструкций.",
       "rule_refs": ["MEM-04"],
       "limitations": ["как клиент размечает результат инструмента в своём контексте, аудитор не наблюдает"]},
      {"id": "F-mine-derivation", "kind": "derivation", "from": "miner", "to": "palace-store",
       "path": "mempalace/miner.py", "symbol": "_build_drawer_metadata",
       "patterns": ["\"source_file\": source_file", "\"added_by\": agent", "\"filed_at\":"],
       "memory_type": "drawer", "provenance_kept": true, "provenance_fields": ["source_file", "added_by", "filed_at"],
       "statement": "Добыча из корпуса сохраняет путь исходного файла и агента в метаданных ящика.",
       "rule_refs": ["MEM-05"]},
      {"id": "F-peer-ingest", "kind": "memory_write", "from": "peer-node", "to": "logstream",
       "path": "mempalace/logsync.py", "symbol": "sync_with_peer",
       "patterns": ["ls\\.apply_remote_event\\(event\\)", "ls\\.apply_remote_artifact\\(artifact\\)"],
       "negate_patterns": ["verify_signature|check_author|validate_content"],
       "memory_type": "event", "audience": "agent", "writer_principal": "peer-node",
       "provenance_kept": true, "provenance_fields": ["origin", "origin_seq"],
       "statement": "События и артефакты пира применяются в локальный лог как есть; подпись автора не проверяется — доверие обеспечивается только владением токеном пира.",
       "rule_refs": ["MEM-05"],
       "limitations": ["целостность обеспечивается транспортом (tailnet + токен), а не проверкой содержимого"]},
      {"id": "F-peer-scope", "kind": "scope_decision", "from": "peer-node", "to": "logstream",
       "path": "mempalace/logsync.py", "symbol": "sync_with_peer",
       "patterns": ["for origin, remote_top in remote_vector\\.items\\(\\)", "ls\\.apply_remote_event\\(event\\)"],
       "decision_source": "peer", "memory_type": "event",
       "statement": "Пир определяет, чьи записи и с какой адресацией попадут в наш лог.",
       "rule_refs": ["MEM-03"]},
      {"id": "F-sync-egress", "kind": "transmit", "from": "mcp-server", "to": "peer-node",
       "path": "mempalace/mcp_server.py", "symbol": "_http_serve_sync",
       "patterns": ["/sync/ops", "list_ops\\(origin, after_seq=after, limit=limit\\)", "/sync/artifact"],
       "negate_patterns": ["categories_allowed|redact|filter_categories"],
       "destination": "peer-node",
       "data_categories_possible": ["event_body", "artifact_content", "patch"],
       "category_filter": false, "composed_by": "protocol",
       "statement": "Эндпоинты /sync/* отдают журнал событий и содержимое артефактов любому предъявителю общего токена; фильтрации по категориям данных нет.",
       "rule_refs": ["EGRESS-01"]},
      {"id": "F-agent-identity", "kind": "identity_binding", "from": "mcp-server", "to": "mcp-server",
       "path": "mempalace/mcp_server.py", "symbol": "tool_event_append",
       "patterns": ["from_agent: str,"],
       "negate_patterns": ["authenticated_principal|request\\.user|token_subject"],
       "identity_source": "body_field", "principal": "agent",
       "statement": "Личность действующего агента берётся из параметра вызова, а не из аутентификации.",
       "rule_refs": ["AUTH-01"],
       "limitations": ["в hub-режиме аутентификация подтверждает только владение общим токеном"]}
    ],
    "auth_transitions": [
      {"id": "AT-hub-tools", "input_principal": "agent", "executing_component": "mcp-server",
       "operation": "*", "resource": "palace(любой ящик, событие, артефакт)", "auth_scheme": "api_key",
       "boundary": "HB-hub", "enforcement_point": "_http_request_rejected",
       "path": "mempalace/mcp_server.py", "symbol": "_http_request_rejected",
       "patterns": ["hmac\\.compare_digest\\(provided, f\"Bearer \\{srv\\.auth_token\\}\"\\)",
                    "handler\\.send_error\\(401, \"Unauthorized\"\\)"],
       "negate_patterns": ["def authorize|check_permission|subject_can"],
       "policy_decision": "not_enforced",
       "statement": "Общий bearer-токен подтверждает подлинность вызывающего, но не ограничивает объекты: любой предъявитель получает все инструменты и всю память.",
       "conditions": ["hub-режим: один токен на все клиентские подключения"]},
      {"id": "AT-sync-pull", "input_principal": "peer-node", "executing_component": "mcp-server",
       "operation": "READ", "resource": "logstream(любой origin)", "auth_scheme": "api_key",
       "boundary": "HB-peer", "enforcement_point": "_http_serve_sync",
       "path": "mempalace/mcp_server.py", "symbol": "_http_serve_sync",
       "patterns": ["list_ops\\(origin, after_seq=after, limit=limit\\)"],
       "negate_patterns": ["peer_allowed|scope_for_peer|authorize_origin"],
       "policy_decision": "not_enforced",
       "statement": "Пир может вытянуть журнал любого origin: ограничения по пиру нет."}
    ],
    "token_validation": [
      {"component": "mcp-server", "path": "mempalace/mcp_server.py", "symbol": "_http_request_rejected",
       "scheme": "api_key",
       "statement": "Транспорт называет секрет bearer-токеном, но по свойствам это статический общий api-key: он не выпускается, не отзывается и не связан с субъектом.",
       "checks": {
         "lookup": {"pattern": "hmac\\.compare_digest\\(provided, f\"Bearer", "found_means": true, "absent_means": false},
         "revocation": {"pattern": "revoke|revocation|token_version|jti|blacklist", "found_means": true, "absent_means": false},
         "binding_to_principal": {"pattern": "principal|subject|agent_id|token_owner", "found_means": true, "absent_means": false}
       }}
    ],
    "background_jobs": [
      {"id": "J-logsync", "component": "logsync", "path": "mempalace/logsync.py", "symbol": "sync_with_peer",
       "patterns": ["origin_seq", "if ls\\.apply_remote_event\\(event\\)"],
       "trigger": "периодический раунд анти-энтропии", "carries_identity": true, "idempotent": true,
       "statement": "Раунд синхронизации несёт origin/origin_seq и идемпотентен по применению.",
       "effects": ["memory_write"]},
      {"id": "J-mine", "component": "miner", "path": "mempalace/miner.py", "symbol": "mine",
       "patterns": ["agent: str = \"mempalace\"", "def mine\\("],
       "trigger": "mempalace_mine / хук завершения сессии", "carries_identity": false, "idempotent": true,
       "statement": "Добыча записывает автором константу по умолчанию, а не инициатора вызова.",
       "effects": ["memory_write"]}
    ],
    "break_points": [
      {"id": "BP-query-sanitizer", "kind": "input_sanitizer", "path": "mempalace/mcp_server.py", "symbol": "tool_search",
       "patterns": ["sanitize_query\\(query\\)"], "durable_control": true,
       "note": "санация поискового запроса против подмешивания инструкций (issue #333)"},
      {"id": "BP-host-origin-pin", "kind": "request_policy", "path": "mempalace/mcp_server.py", "symbol": "_http_request_rejected",
       "patterns": ["srv\\.enforce_host_pin", "_http_origin_allowed\\(origin\\)"], "durable_control": true,
       "note": "проверка Host и Origin до диспетчеризации запроса"}
    ]
  },
  "boundaries": [
    {"id": "HB-hub", "from": "agent", "to": "mcp-server",
     "rule": "общий bearer-токен подтверждает подлинность, но не ограничивает объекты",
     "enforcement_point": "_http_request_rejected"},
    {"id": "HB-peer", "from": "peer-node", "to": "logstream",
     "rule": "пир применяет свои события в наш лог, ограничен только владением токеном",
     "enforcement_point": "logsync.sync_with_peer"}
  ],
  "chains": [
    {"id": "peer-content-to-agent-context", "title": "Событие пира → локальный лог → выдача агенту по to_agent → контекст модели",
     "nodes": ["peer-node", "logstream", "mcp-server", "agent"], "rule_refs": ["MEM-01", "MEM-03"], "legs_present": true}
  ]
}
